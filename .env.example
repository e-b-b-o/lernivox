# ============================================================
# Lernivox — Environment Configuration Template
# ============================================================
# Copy this file to .env:
#   cp .env.example .env
# Never commit real credentials or secrets to version control.
# ============================================================

# --- Node Environment ---
NODE_ENV=development

# --- API Server (apps/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Web Application (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- PostgreSQL Database with pgvector (packages/database) ---
# Default local docker compose mapping is port 5433 (to avoid host 5432 conflicts)
DATABASE_URL=postgresql://lernivox:lernivox_dev_password@localhost:5433/lernivox?schema=public
POSTGRES_USER=lernivox
POSTGRES_PASSWORD=lernivox_dev_password
POSTGRES_DB=lernivox
POSTGRES_PORT=5433

# --- Redis & BullMQ Background Worker (apps/worker) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Provider Configuration (packages/ai-core - Provisional) ---
# Active provider abstraction (default: google-gemini)
AI_PROVIDER=google-gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.5-flash
# Gemini Embedding Model (options: gemini-embedding-2 | gemini-embedding-2-preview | gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder

# --- Storage Configuration (packages/storage - Provisional) ---
# Default local driver: local (options: local | cloudinary)
STORAGE_DRIVER=local
# When STORAGE_DRIVER=cloudinary, set the unified Cloudinary connection URL:
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Authentication & Session Security (apps/api) ---
JWT_SECRET=your_jwt_secret_dev_key_min_32_characters_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3000

# --- Google OAuth 2.0 (apps/api - Optional for local mock testing) ---
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback


